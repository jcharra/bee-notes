    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "deploy": "ionic build --prod -- --base-href https://beenotesapp.charra.de && npx angular-cli-ghpages --dir=www",
